# Copy to .env and fill in real values. ASP.NET Core maps the `__` separator
# to configuration sections, so these override the empty values in appsettings.json.
#
# Local run:   set these in your shell, or use `dotnet user-secrets`
# Docker run:  docker run --env-file .env ...

GoogleAuth__ClientId=
GoogleAuth__ClientSecret=
GoogleTranslate__ApiKey=
Jwt__Key=
